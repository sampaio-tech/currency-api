meta {
  name: EUR Rates by Date
  type: http
  seq: 2
}

get {
  url: {{dateBaseUrl}}/v1/currencies/eur.json
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("has date field", function() {
    expect(res.body).to.have.property("date");
  });
  test("has no timestamp field (date-only snapshot)", function() {
    expect(res.body).to.not.have.property("timestamp");
  });
  test("has eur rates object", function() {
    expect(res.body).to.have.property("eur");
    expect(res.body.eur).to.be.an("object");
  });
}
