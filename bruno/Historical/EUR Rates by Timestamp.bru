meta {
  name: EUR Rates by Timestamp
  type: http
  seq: 4
}

get {
  url: {{timestampBaseUrl}}/v1/currencies/eur.json
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("has date field", function() {
    expect(res.body).to.have.property("date");
  });
  test("has timestamp field (sub-daily snapshot)", function() {
    expect(res.body).to.have.property("timestamp");
  });
  test("has eur rates object", function() {
    expect(res.body).to.have.property("eur");
    expect(res.body.eur).to.be.an("object");
  });
}
