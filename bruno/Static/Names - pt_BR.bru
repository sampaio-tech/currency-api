meta {
  name: Currency Names (pt_BR)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/currencies/names/pt_BR.json
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("has USD name", function() {
    expect(res.body).to.have.property("USD");
  });
  test("has BRL name", function() {
    expect(res.body).to.have.property("BRL");
  });
}
